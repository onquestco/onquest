# Supabase (use the new publishable/secret keys, not legacy anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only, Production env only

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Place names (OpenStreetMap Nominatim). The contact address goes in every request's User-Agent,
# as Nominatim's usage policy asks. Unset: no Nominatim calls, cached names only. Server only.
GEOCODER_CONTACT_EMAIL=

# Automatic captions (Claude Haiku). Unset: no captions. Server only, Production + Preview.
ANTHROPIC_API_KEY=

# Notification emails (Resend). Unset: no emails, the bell still works. Server only.
RESEND_API_KEY=
# Notification emails a day (default 70), leaving room for sign-in links in Resend's free 100.
NOTIFY_EMAIL_DAILY_BUDGET=70
# Signs unsubscribe links: "v1:<random 32+ chars>"; to rotate, append ",v2:<new>". Server only.
EMAIL_LINK_SECRET=
# Vercel cron (finishing interrupted account deletions): any long random string. Vercel sends it
# as "Authorization: Bearer …". Server only, Production + Preview.
CRON_SECRET=

# Product analytics (PostHog). Unset: nothing is sent anywhere. The project key is public by
# design (it only writes events). POSTHOG_HOST: us.i.posthog.com or eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=us.i.posthog.com
# Analytics environment: every event carries env = production / preview, from VERCEL_ENV on the
# server and NEXT_PUBLIC_VERCEL_ENV in the browser (both set by Vercel; anything else is preview).

# Analytics user_info (docs/decisions/0004-user-info-and-email-in-analytics.md): username, email
# and city on signed-in events, attached on the server only. off (default) | team | on.
# Production stays off until the privacy policy is live and erasure is proved (spec gates G3–G6);
# Preview uses team. Read at runtime. Server only.
ANALYTICS_USER_INFO=off
# Comma list of the team's test-account user keys, used only by ANALYTICS_USER_INFO=team.
ANALYTICS_USER_INFO_TEAM_KEYS=
# The oq_actx analytics cookie (random device + visit id, screen, platform) for server events.
# Off until the privacy policy is live (gate G3). Inlined at build time: redeploy after changing.
NEXT_PUBLIC_ANALYTICS_CONTEXT_COOKIE=off

# Analytics erasure on account deletion (docs/runbooks/analytics-erasure.md). Each store is skipped
# until all of its variables are set; the daily job then logs "Analytics erasure pending: N".
# One set, in Vercel Production and Preview (shared PostHog project and dataset). Server only.
# PostHog private API: us.posthog.com or eu.posthog.com (not the us.i. ingestion host).
POSTHOG_API_HOST=
# Numeric project id (PostHog: Project settings).
POSTHOG_PROJECT_ID=
# Personal API key scoped to this project with person:write only. Secret.
POSTHOG_PERSONAL_API_KEY=
# Service account analytics-eraser's JSON key, base64 (base64 -w0 key.json). Secret.
BIGQUERY_ERASER_KEY=
BIGQUERY_DATASET=onquest_analytics
# The dataset's location, e.g. US or asia-south1 (BigQuery: dataset details).
BIGQUERY_LOCATION=

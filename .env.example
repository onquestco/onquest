# Supabase (use the new publishable/secret keys, not legacy anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only, Production env only

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Place names (OpenStreetMap Nominatim). The contact address goes in every request's User-Agent,
# as Nominatim's usage policy asks. Unset: no Nominatim calls, cached names only. Server only.
GEOCODER_CONTACT_EMAIL=

# Automatic captions (Claude Haiku). Unset: no captions. Server only, Production + Preview.
ANTHROPIC_API_KEY=

# Notification emails (Resend). Unset: no emails, the bell still works. Server only.
RESEND_API_KEY=
# Notification emails a day (default 70), leaving room for sign-in links in Resend's free 100.
NOTIFY_EMAIL_DAILY_BUDGET=70
# Signs unsubscribe links: "v1:<random 32+ chars>"; to rotate, append ",v2:<new>". Server only.
EMAIL_LINK_SECRET=
